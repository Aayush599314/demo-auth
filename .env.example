# ─── Firebase (client-side — safe to expose in browser builds) ────────────────
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ─── Supabase (client-side — publishable / anon key only) ────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Firebase Admin (server-side ONLY — used by scripts/provision-claims.mjs) ─
# Path to the service-account JSON downloaded from Firebase Console.
# NEVER bundle this into your frontend build.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
